# Скопировать в .env в корне репозитория и заполнить. Один файл читают трое:
#   - docker compose — автоматически (лежит рядом), оба файла: prod и dev;
#   - back — через envFilePath ../.env;
#   - vite — через envDir '..'.
# На сервере .env создаётся руками в /srv/flatnik — деплой его не трогает.
# Все переменные ниже имеют дефолты в compose-файлах: без .env стек тоже поднимется.

# Порты. GATEWAY_PORT — это порт dev-гейтвея на хосте; в production стек наружу
# не публикует ничего вообще, 80 и 443 держит отдельный edge-gateway (/srv/edge).
# back и front доступны лишь внутри сети compose — на этом держится модель
# доступа, порты им не пробрасываются ни в одном из режимов.
GATEWAY_PORT=8080
BACK_PORT=3000
FRONT_PORT=5173

# Postgres. Этими же значениями инициализируется контейнер БД.
# POSTGRES_HOST/PORT — для подключения с хоста; в контейнере back ходит на postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flatnik
POSTGRES_PASSWORD=flatnik
POSTGRES_DB=flatnik

# JWT авторизации. На сервере обязательно заменить секрет на случайную строку.
JWT_SECRET=flatnik-dev-secret
JWT_EXPIRES_IN=30d

# Yandex SmartCaptcha (ключи — в console.yandex.cloud).
# Пустые значения = проверка капчи выключена, и в формах видна плашка об этом.
# Годится только для разработки: в production пустой SMARTCAPTCHA_SERVER_KEY
# останавливает старт бэкенда.
SMARTCAPTCHA_SERVER_KEY=
VITE_SMARTCAPTCHA_CLIENT_KEY=

# SMS Aero — вход по телефону (кабинет smsaero.ru). Способ входа один:
# «мобильная авторизация» (mobile-id). Подтверждение приходит на SIM-карту, а
# если SIM-PUSH не сработал, провайдер сам присылает одноразовый код в SMS.
# Запасных путей нет: недоступен провайдер — вход не работает.
# Доступы к API идут парой: SMSAERO_EMAIL — логин аккаунта, SMSAERO_API_KEY — ключ.
# Пусто = вход не работает совсем; в production пустые доступы останавливают старт.
#
# Тестовый режим включается самим ключом, отдельного флага нет: возьмите тестовый
# ключ в «Настройки → API и SMPP» и оставьте SMSAERO_SIGN пустым. SMS не уходят,
# списаний нет, код подтверждения всегда 1234. Имя отправителя для этого
# оформлять не нужно.
#
# SMSAERO_SIGN — своё имя отправителя, заказывается в кабинете и нужно только
# для боевого режима. Пусто = подставляется бесплатное «SMS Aero»: в mobile-id
# подпись обязательна по схеме метода, и в тестовом режиме требуется именно она.
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=

# Адрес сайта наружу. Из него собирается callbackUrl для mobile-id (результат мы
# узнаём опросом статуса, но поле в запросе провайдер требует заполненным) и
# canonical с og:url на публичных страницах. Брать хост из заголовков запроса
# нельзя: за edge-прокси туда попадает внутреннее имя контейнера.
# Менять нужно, только если домен не flatnik.ru.
PUBLIC_URL=https://flatnik.ru

# Откуда серверный рендер берёт шаблон index.html, чтобы подставить в него мету
# и тексты отзывов. Значение задано в обоих compose-файлах и здесь нужно только
# для запуска бэкенда вне Docker: в production это файл из тома со сборкой
# фронта, в разработке — адрес vite (он добавляет в HTML свой клиент).
# SEO_INDEX_HTML=/srv/static/index.html

# Swagger UI на /api/docs. В production выключен (значение задано в
# docker-compose.prod.yml): документация API — не публичная страница.
# SWAGGER_UI=off

# Телеграм-бот модерации: присылает новые отзывы с кнопками «Одобрить»/«Отклонить».
# Токен выдаёт @BotFather; TELEGRAM_MODERATOR_CHAT_ID — чат, из которого бот
# принимает команды: напишите боту что угодно и возьмите id из лога бэкенда.
# Пусто = бот не запускается, отзывы копятся в статусе pending (команда /pending
# покажет их, когда бот включат). Старт бэкенда это не блокирует нигде.
# Для разработки нужен отдельный бот: два процесса с одним токеном получают 409.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=

# Номер счётчика Яндекс.Метрики (metrika.yandex.ru). Пусто = счётчик не ставится.
# Это не только аналитика: поведение посетителей из поиска Яндекс учитывает при
# ранжировании. Инлайнится в бандл при сборке — менять нужно с пересборкой фронта.
VITE_YANDEX_METRICA_ID=

# Ключ Яндекс Карт (кабинет developer.tech.yandex.ru). Один ключ на три сервиса:
# JS API (карта), Geocoder (поиск адреса и адрес по клику) и Suggest (подсказки) —
# последние два подключаются к нему в кабинете, иначе поиск отвечает отказом.
# Пустое значение = вместо карты показывается заглушка.
VITE_YANDEX_MAPS_API_KEY=
