# Гейтвей dev-режима: единственная точка входа, front и back на одном origin.
# Шаблон, а не готовый конфиг: nginx-образ подставляет ${BACK_PORT} и ${FRONT_PORT}
# через envsubst на старте (см. environment сервиса gateway в docker-compose.yml).

# Апгрейд до WebSocket нужен HMR-сокету vite. Пустой Upgrade превращаем в
# Connection: close, иначе обычные запросы уйдут с мусорным заголовком.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Встроенный DNS Docker'а. Без resolver'а и переменных в proxy_pass nginx
    # резолвит имена front/back один раз на старте: пересозданный контейнер
    # получает новый IP, и гейтвей отдаёт 502 до собственного рестарта.
    # Переменная заставляет nginx перерезолвить имя с учётом valid=10s.
    resolver 127.0.0.11 valid=10s;

    # Загрузка исходников в dev идёт без сжатия и большими пачками — лимит снимаем.
    client_max_body_size 20m;

    # /api — в NestJS. Объявлено до location /, чтобы SPA-фоллбэк его не перехватил.
    location /api/ {
        set $back_upstream http://back:${BACK_PORT};
        proxy_pass $back_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Всё остальное — vite dev server вместе с его HMR-сокетом. Отдельный порт
    # для HMR не нужен: клиент vite стучится в origin страницы, то есть сюда же.
    location / {
        set $front_upstream http://front:${FRONT_PORT};
        proxy_pass $front_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Сокет HMR живёт часами и молчит между правками — таймаут не должен его рвать.
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        # Ответы vite отдаём как есть: буферизация ломает поток обновлений.
        proxy_buffering off;
    }
}
