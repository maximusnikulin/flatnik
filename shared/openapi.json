{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Проверка живости бэкенда",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/request-code": {
      "post": {
        "operationId": "AuthController_requestCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCodeDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Код сгенерирован и записан в лог"
          },
          "403": {
            "description": "Не пройдена проверка капчи"
          }
        },
        "summary": "Запросить код подтверждения; заглушка пишет код в лог бэкенда",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/verify-code": {
      "post": {
        "operationId": "AuthController_verifyCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Неверный или истёкший код"
          }
        },
        "summary": "Обменять код из лога на JWT",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Профиль текущего пользователя",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me/nickname": {
      "patch": {
        "operationId": "AuthController_setNickname",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetNicknameDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "409": {
            "description": "Никнейм уже занят"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Выбрать никнейм; он же подтверждает автоматически выданный при регистрации",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/houses": {
      "get": {
        "operationId": "HousesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HousePinDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Все дома с отзывами — пины на карте",
        "tags": [
          "houses"
        ]
      }
    },
    "/api/houses/by-address": {
      "get": {
        "operationId": "HousesController_byAddress",
        "parameters": [
          {
            "name": "address",
            "required": true,
            "in": "query",
            "description": "Канонический адрес, как его вернул геокодер",
            "schema": {
              "maxLength": 500,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseLookupResponseDto"
                }
              }
            }
          }
        },
        "summary": "Дом с квартирами по адресу; house = null, если отзывов ещё нет",
        "tags": [
          "houses"
        ]
      }
    },
    "/api/reviews/me": {
      "get": {
        "operationId": "ReviewsController_listMine",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyReviewDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет или истёк токен авторизации"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Свои отзывы с адресами квартир, недавно изменённые сверху",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/reviews": {
      "post": {
        "operationId": "ReviewsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCreatedDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет или истёк токен авторизации"
          },
          "403": {
            "description": "Не пройдена проверка капчи"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Создать отзыв; дом и квартира заводятся автоматически",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/apartments/{id}/reviews": {
      "get": {
        "operationId": "ApartmentReviewsController_list",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Отзывы одной квартиры, новые сверху",
        "tags": [
          "reviews"
        ]
      }
    }
  },
  "info": {
    "title": "flatnik API",
    "description": "HTTP-контракт бэкенда flatnik",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Текущее состояние сервиса",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "description": "Имя сервиса, ответившего на запрос",
            "example": "back"
          },
          "uptime": {
            "type": "number",
            "description": "Аптайм процесса в секундах",
            "example": 1234
          },
          "timestamp": {
            "type": "string",
            "description": "Время формирования ответа, ISO 8601",
            "format": "date-time",
            "example": "2026-08-10T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "uptime",
          "timestamp"
        ]
      },
      "RequestCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон в российском формате",
            "pattern": "/^\\+7\\d{10}$/",
            "example": "+79991234567"
          },
          "captchaToken": {
            "type": "string",
            "description": "Токен SmartCaptcha; обязателен, когда проверка капчи включена"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон в российском формате",
            "pattern": "/^\\+7\\d{10}$/",
            "example": "+79991234567"
          },
          "code": {
            "type": "string",
            "description": "Шестизначный код из лога бэкенда",
            "pattern": "/^\\d{6}$/",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон, на который выдан токен",
            "example": "+79991234567"
          },
          "nickname": {
            "type": "string",
            "description": "Публичный ник; им подписаны отзывы",
            "example": "maxim_n"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор пользователя"
          },
          "nicknameConfirmed": {
            "type": "boolean",
            "description": "false — ник сгенерирован автоматически и пользователь его ещё не выбирал.\nФронт по этому флагу показывает обязательный шаг ввода ника."
          }
        },
        "required": [
          "phone",
          "nickname",
          "id",
          "nicknameConfirmed"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer-токен для заголовка Authorization"
          },
          "user": {
            "description": "Профиль вошедшего пользователя",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto"
              }
            ]
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "SetNicknameDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "Никнейм: буквы, цифры и подчёркивание, 3–20 символов. Пробелов нет\nнамеренно — ник подписывает отзывы и читается как идентификатор.\nЗанятость проверяется без учёта регистра.",
            "pattern": "/^[\\p{L}\\p{N}_]{3,20}$/u",
            "example": "maxim_n",
            "minLength": 3,
            "maxLength": 20
          }
        },
        "required": [
          "nickname"
        ]
      },
      "HousePinDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор дома"
          },
          "address": {
            "type": "string",
            "description": "Отображаемый адрес"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "confirmedCount": {
            "type": "number",
            "description": "Подтверждённых отзывов по всем квартирам дома"
          },
          "pendingCount": {
            "type": "number",
            "description": "Неподтверждённых отзывов по всем квартирам дома"
          }
        },
        "required": [
          "id",
          "address",
          "lat",
          "lon",
          "confirmedCount",
          "pendingCount"
        ]
      },
      "ApartmentSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор квартиры"
          },
          "number": {
            "type": "string",
            "description": "Номер квартиры"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд"
          },
          "confirmedCount": {
            "type": "number",
            "description": "Подтверждённых отзывов"
          },
          "pendingCount": {
            "type": "number",
            "description": "Неподтверждённых отзывов"
          }
        },
        "required": [
          "id",
          "number",
          "entrance",
          "confirmedCount",
          "pendingCount"
        ]
      },
      "HouseWithApartmentsDto": {
        "type": "object",
        "properties": {
          "apartments": {
            "description": "Квартиры дома, по которым есть отзывы",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApartmentSummaryDto"
            }
          },
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "apartments",
          "id",
          "address",
          "lat",
          "lon"
        ]
      },
      "HouseLookupResponseDto": {
        "type": "object",
        "properties": {
          "house": {
            "nullable": true,
            "description": "null — по этому адресу ещё нет ни одного отзыва",
            "allOf": [
              {
                "$ref": "#/components/schemas/HouseWithApartmentsDto"
              }
            ]
          }
        },
        "required": [
          "house"
        ]
      },
      "ReviewStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed"
        ]
      },
      "MyReviewDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              }
            ]
          },
          "periodFrom": {
            "type": "string",
            "nullable": true,
            "description": "Начало периода съёма",
            "example": "2024-03-12"
          },
          "periodTo": {
            "type": "string",
            "nullable": true,
            "description": "Конец периода съёма",
            "example": "2025-04-12"
          },
          "apartmentNumber": {
            "type": "string",
            "description": "Номер квартиры",
            "example": "120"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд",
            "example": "7"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор отзыва"
          },
          "text": {
            "type": "string",
            "description": "Текст отзыва"
          },
          "createdAt": {
            "type": "string",
            "description": "Дата создания, ISO 8601"
          },
          "updatedAt": {
            "type": "string",
            "description": "Дата последней правки, ISO 8601; по ней отсортирован список"
          },
          "apartmentId": {
            "type": "string",
            "description": "Идентификатор квартиры, о которой отзыв"
          },
          "address": {
            "type": "string",
            "description": "Адрес дома"
          },
          "lat": {
            "type": "number",
            "description": "Широта дома — к этой точке перелетает карта"
          },
          "lon": {
            "type": "number",
            "description": "Долгота дома"
          }
        },
        "required": [
          "status",
          "periodFrom",
          "periodTo",
          "apartmentNumber",
          "entrance",
          "id",
          "text",
          "createdAt",
          "updatedAt",
          "apartmentId",
          "address",
          "lat",
          "lon"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "apartmentNumber": {
            "type": "string",
            "description": "Номер квартиры",
            "minLength": 1,
            "maxLength": 20,
            "example": "120"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд; обязателен — API Яндекса его не отдаёт, вводится вручную",
            "minLength": 1,
            "maxLength": 20,
            "example": "7"
          },
          "egrn": {
            "type": "string",
            "description": "Кадастровый номер из выписки ЕГРН",
            "pattern": "/^[\\d:]{5,40}$/",
            "example": "77:01:0001075:1234"
          },
          "periodFrom": {
            "type": "string",
            "description": "Начало периода съёма, ISO-дата",
            "pattern": "/^\\d{4}-\\d{2}-\\d{2}$/",
            "example": "2024-03-12"
          },
          "periodTo": {
            "type": "string",
            "description": "Конец периода съёма, ISO-дата",
            "pattern": "/^\\d{4}-\\d{2}-\\d{2}$/",
            "example": "2025-04-12"
          },
          "address": {
            "type": "string",
            "description": "Канонический адрес дома от геокодера",
            "minLength": 5,
            "maxLength": 500
          },
          "lat": {
            "type": "number",
            "description": "Широта дома",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "description": "Долгота дома",
            "minimum": -180,
            "maximum": 180
          },
          "text": {
            "type": "string",
            "description": "Текст отзыва",
            "minLength": 10,
            "maxLength": 10000
          },
          "captchaToken": {
            "type": "string",
            "description": "Токен SmartCaptcha; обязателен, когда проверка капчи включена"
          }
        },
        "required": [
          "apartmentNumber",
          "entrance",
          "egrn",
          "address",
          "lat",
          "lon",
          "text"
        ]
      },
      "ReviewCreatedDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              }
            ]
          },
          "reviewId": {
            "type": "string"
          },
          "houseId": {
            "type": "string"
          },
          "apartmentId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "reviewId",
          "houseId",
          "apartmentId"
        ]
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              }
            ]
          },
          "periodFrom": {
            "type": "string",
            "nullable": true,
            "description": "Начало периода съёма",
            "example": "2024-03-12"
          },
          "periodTo": {
            "type": "string",
            "nullable": true,
            "description": "Конец периода съёма",
            "example": "2025-04-12"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор отзыва"
          },
          "authorName": {
            "type": "string",
            "description": "Никнейм автора"
          },
          "text": {
            "type": "string",
            "description": "Текст отзыва"
          },
          "createdAt": {
            "type": "string",
            "description": "Дата создания, ISO 8601"
          }
        },
        "required": [
          "status",
          "periodFrom",
          "periodTo",
          "id",
          "authorName",
          "text",
          "createdAt"
        ]
      }
    }
  }
}
