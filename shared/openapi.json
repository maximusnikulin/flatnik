{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Проверка живости бэкенда",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/request-code": {
      "post": {
        "operationId": "AuthController_requestCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCodeResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Не пройдена проверка капчи"
          },
          "429": {
            "description": "Вход по этому номеру запрошен меньше минуты назад"
          },
          "503": {
            "description": "Провайдер недоступен"
          }
        },
        "summary": "Начать вход: мобильная авторизация на указанный номер, а если она недоступна —\nкод в Telegram. Что показывать дальше, говорит ответ: `needsCode`.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/session": {
      "post": {
        "operationId": "AuthController_pollSession",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPollDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusDto"
                }
              }
            }
          }
        },
        "summary": "Узнать, подтвердил ли человек вход на телефоне. Фронт опрашивает этот метод,\nпока идёт мобильная авторизация; при подтверждении в ответе сразу токен.\n\nPOST, а не GET: телефон и секрет сессии в query-строке осели бы в логах nginx.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/mobile-id/callback": {
      "post": {
        "operationId": "AuthController_mobileIdCallback",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Уведомление принято"
          }
        },
        "summary": "Приёмник статусов мобильной авторизации. Решение принимает опрос статуса\n(см. `session`), поэтому здесь только запись в лог: адрес обязателен в запросе\nк провайдеру, и без эндпоинта он стучался бы в 404.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/verify-code": {
      "post": {
        "operationId": "AuthController_verifyCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Неверный, истёкший код или исчерпаны попытки"
          }
        },
        "summary": "Обменять код из сообщения на JWT",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Профиль текущего пользователя",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me/nickname": {
      "patch": {
        "operationId": "AuthController_setNickname",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetNicknameDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "409": {
            "description": "Никнейм уже занят"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Выбрать никнейм; он же подтверждает автоматически выданный при регистрации",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/houses": {
      "get": {
        "operationId": "HousesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HousePinDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Все дома с отзывами — пины на карте",
        "tags": [
          "houses"
        ]
      }
    },
    "/api/houses/by-address": {
      "get": {
        "operationId": "HousesController_byAddress",
        "parameters": [
          {
            "name": "address",
            "required": true,
            "in": "query",
            "description": "Канонический адрес, как его вернул геокодер",
            "schema": {
              "maxLength": 500,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseLookupResponseDto"
                }
              }
            }
          }
        },
        "summary": "Дом с квартирами по адресу; house = null, если отзывов ещё нет",
        "tags": [
          "houses"
        ]
      }
    },
    "/api/reviews/me": {
      "get": {
        "operationId": "ReviewsController_listMine",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyReviewDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет или истёк токен авторизации"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Свои отзывы с адресами квартир, недавно изменённые сверху",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/reviews": {
      "post": {
        "operationId": "ReviewsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCreatedDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет или истёк токен авторизации"
          },
          "403": {
            "description": "Не пройдена проверка капчи"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Создать отзыв; дом и квартира заводятся автоматически",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/reviews/{id}": {
      "patch": {
        "operationId": "ReviewsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateReviewDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyReviewDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет или истёк токен авторизации"
          },
          "403": {
            "description": "Не пройдена проверка капчи"
          },
          "404": {
            "description": "Своего отзыва с таким идентификатором нет"
          },
          "409": {
            "description": "Отзыв на проверке у модератора"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Изменить свой отзыв; правка возвращает его на проверку модератору",
        "tags": [
          "reviews"
        ]
      }
    },
    "/api/apartments/{id}/reviews": {
      "get": {
        "operationId": "ApartmentReviewsController_list",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Отзывы одной квартиры, новые сверху",
        "tags": [
          "reviews"
        ]
      }
    }
  },
  "info": {
    "title": "flatnik API",
    "description": "HTTP-контракт бэкенда flatnik",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Текущее состояние сервиса",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "description": "Имя сервиса, ответившего на запрос",
            "example": "back"
          },
          "uptime": {
            "type": "number",
            "description": "Аптайм процесса в секундах",
            "example": 1234
          },
          "timestamp": {
            "type": "string",
            "description": "Время формирования ответа, ISO 8601",
            "format": "date-time",
            "example": "2026-08-10T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "uptime",
          "timestamp"
        ]
      },
      "RequestCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон в российском формате; номера других стран не обслуживаем",
            "pattern": "/^\\+7\\d{10}$/",
            "example": "+79991234567"
          },
          "captchaToken": {
            "type": "string",
            "description": "Токен SmartCaptcha. Опционален в схеме, потому что в разработке ключей может\nне быть; когда серверный ключ задан, отсутствие токена даёт 400 в CaptchaService."
          }
        },
        "required": [
          "phone"
        ]
      },
      "RequestCodeResponseDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "description": "`mobile-id` — подтверждение приходит на SIM-карту, `code` — запасной путь\nс кодом в сообщении.",
            "enum": [
              "mobile-id",
              "code"
            ]
          },
          "sessionId": {
            "type": "string",
            "description": "Секрет для опроса статуса входа",
            "example": "3f2a9c1d4b5e6f708192a3b4c5d6e7f8"
          },
          "needsCode": {
            "type": "boolean",
            "description": "true — показать поле ввода кода; false — ждать подтверждения на телефоне"
          }
        },
        "required": [
          "method",
          "sessionId",
          "needsCode"
        ]
      },
      "SessionPollDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон в российском формате; номера других стран не обслуживаем",
            "pattern": "/^\\+7\\d{10}$/",
            "example": "+79991234567"
          },
          "sessionId": {
            "type": "string",
            "description": "Секрет, выданный при запросе входа: без него статус чужого номера не опросить",
            "pattern": "/^[0-9a-f]{32}$/",
            "example": "3f2a9c1d4b5e6f708192a3b4c5d6e7f8"
          }
        },
        "required": [
          "phone",
          "sessionId"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон, на который выдан токен",
            "example": "+79991234567"
          },
          "nickname": {
            "type": "string",
            "description": "Публичный ник; им подписаны отзывы",
            "example": "maxim_n"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор пользователя"
          },
          "nicknameConfirmed": {
            "type": "boolean",
            "description": "false — ник сгенерирован автоматически и пользователь его ещё не выбирал.\nФронт по этому флагу показывает обязательный шаг ввода ника."
          }
        },
        "required": [
          "phone",
          "nickname",
          "id",
          "nicknameConfirmed"
        ]
      },
      "SessionStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "`pending` — ждём подтверждения, `confirmed` — вход состоялся и в ответе есть\nтокен, `expired` — попытка истекла или секрет не подошёл, нужен новый запрос.",
            "enum": [
              "pending",
              "confirmed",
              "expired"
            ]
          },
          "accessToken": {
            "type": "string",
            "description": "Только при `confirmed`"
          },
          "user": {
            "description": "Только при `confirmed`",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto"
              }
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "VerifyCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Телефон в российском формате; номера других стран не обслуживаем",
            "pattern": "/^\\+7\\d{10}$/",
            "example": "+79991234567"
          },
          "code": {
            "type": "string",
            "description": "Код из сообщения. Длина не фиксирована шестью цифрами: свой код мы генерируем\nшестизначным, но в мобильной авторизации код выдаёт провайдер.",
            "pattern": "/^\\d{4,8}$/",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer-токен для заголовка Authorization"
          },
          "user": {
            "description": "Профиль вошедшего пользователя",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto"
              }
            ]
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "SetNicknameDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "Никнейм: буквы, цифры и подчёркивание, 3–20 символов. Пробелов нет\nнамеренно — ник подписывает отзывы и читается как идентификатор.\nЗанятость проверяется без учёта регистра.",
            "pattern": "/^[\\p{L}\\p{N}_]{3,20}$/u",
            "example": "maxim_n",
            "minLength": 3,
            "maxLength": 20
          }
        },
        "required": [
          "nickname"
        ]
      },
      "HousePinDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор дома"
          },
          "address": {
            "type": "string",
            "description": "Отображаемый адрес"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "confirmedCount": {
            "type": "number",
            "description": "Подтверждённых отзывов по всем квартирам дома; других публично не существует"
          }
        },
        "required": [
          "id",
          "address",
          "lat",
          "lon",
          "confirmedCount"
        ]
      },
      "ApartmentSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор квартиры"
          },
          "number": {
            "type": "string",
            "description": "Номер квартиры"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд"
          },
          "confirmedCount": {
            "type": "number",
            "description": "Подтверждённых отзывов"
          }
        },
        "required": [
          "id",
          "number",
          "entrance",
          "confirmedCount"
        ]
      },
      "HouseWithApartmentsDto": {
        "type": "object",
        "properties": {
          "apartments": {
            "description": "Квартиры дома, по которым есть подтверждённые отзывы",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApartmentSummaryDto"
            }
          },
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "apartments",
          "id",
          "address",
          "lat",
          "lon"
        ]
      },
      "HouseLookupResponseDto": {
        "type": "object",
        "properties": {
          "house": {
            "nullable": true,
            "description": "null — по этому адресу ещё нет ни одного отзыва",
            "allOf": [
              {
                "$ref": "#/components/schemas/HouseWithApartmentsDto"
              }
            ]
          }
        },
        "required": [
          "house"
        ]
      },
      "ReviewStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "rejected"
        ]
      },
      "MyReviewDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              }
            ]
          },
          "periodFrom": {
            "type": "string",
            "nullable": true,
            "description": "Начало периода съёма, месяц и год",
            "example": "2024-03"
          },
          "periodTo": {
            "type": "string",
            "nullable": true,
            "description": "Конец периода съёма, месяц и год",
            "example": "2025-04"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true,
            "description": "Причина отклонения от модератора; null — отзыв не отклоняли"
          },
          "apartmentNumber": {
            "type": "string",
            "description": "Номер квартиры",
            "example": "120"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд",
            "example": "7"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор отзыва"
          },
          "text": {
            "type": "string",
            "description": "Текст отзыва"
          },
          "createdAt": {
            "type": "string",
            "description": "Дата создания, ISO 8601"
          },
          "updatedAt": {
            "type": "string",
            "description": "Дата последней правки, ISO 8601; по ней отсортирован список"
          },
          "apartmentId": {
            "type": "string",
            "description": "Идентификатор квартиры, о которой отзыв"
          },
          "address": {
            "type": "string",
            "description": "Адрес дома"
          },
          "lat": {
            "type": "number",
            "description": "Широта дома — к этой точке перелетает карта"
          },
          "lon": {
            "type": "number",
            "description": "Долгота дома"
          }
        },
        "required": [
          "status",
          "periodFrom",
          "periodTo",
          "rejectionReason",
          "apartmentNumber",
          "entrance",
          "id",
          "text",
          "createdAt",
          "updatedAt",
          "apartmentId",
          "address",
          "lat",
          "lon"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "apartmentNumber": {
            "type": "string",
            "description": "Номер квартиры",
            "minLength": 1,
            "maxLength": 20,
            "example": "120"
          },
          "entrance": {
            "type": "string",
            "description": "Подъезд; обязателен — API Яндекса его не отдаёт, вводится вручную",
            "minLength": 1,
            "maxLength": 20,
            "example": "7"
          },
          "egrn": {
            "type": "string",
            "description": "Кадастровый номер из выписки ЕГРН: округ:район:квартал:объект.\nКвартал — шесть или семь цифр, номер объекта — от одной.\nТот же формат задаёт маска поля на фронте.",
            "pattern": "/^\\d{2}:\\d{2}:\\d{6,7}:\\d{1,10}$/",
            "example": "77:01:0001075:1234"
          },
          "periodFrom": {
            "type": "string",
            "description": "Начало периода съёма, месяц и год",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "example": "2024-03"
          },
          "periodTo": {
            "type": "string",
            "description": "Конец периода съёма, месяц и год",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "example": "2025-04"
          },
          "address": {
            "type": "string",
            "description": "Канонический адрес дома от геокодера",
            "minLength": 5,
            "maxLength": 500
          },
          "lat": {
            "type": "number",
            "description": "Широта дома",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "description": "Долгота дома",
            "minimum": -180,
            "maximum": 180
          },
          "text": {
            "type": "string",
            "description": "Текст отзыва",
            "minLength": 10,
            "maxLength": 500
          },
          "captchaToken": {
            "type": "string",
            "description": "Токен SmartCaptcha; обязателен, когда проверка капчи включена"
          }
        },
        "required": [
          "apartmentNumber",
          "entrance",
          "egrn",
          "address",
          "lat",
          "lon",
          "text"
        ]
      },
